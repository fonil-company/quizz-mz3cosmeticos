# WhatsApp comercial por estado (somente dígitos, com DDI 55 + DDD).
# Opcional: se vazio, usa os números padrão definidos em src/config/env.ts
# (PI: 5586993271298 · MA: 5586995319157).
VITE_WHATSAPP_NUMBER_PI=
VITE_WHATSAPP_NUMBER_MA=

# Webhooks HTTP (POST JSON) por estado. Opcionais: se vazios, usa os webhooks
# de captação definidos em src/config/env.ts (PI: Henrique; MA: Francisca).
# Essas URLs ficam visíveis no navegador. Credenciais privadas ficam no backend.
VITE_CRM_ENDPOINT_PI=
VITE_CRM_ENDPOINT_MA=

# Backend/proxy genérico: fallback apenas para UFs sem webhook estadual.
VITE_CRM_ENDPOINT=

# ID do Meta Pixel (opcional). Sem ele, os eventos não são disparados.
VITE_META_PIXEL_ID=
